[Unit]
Description=Moonlight Web Stream bridge
After=network.target frps.service

[Service]
Type=simple
WorkingDirectory=/opt/moonlight-web/package
# HTTPS 自签名证书生成:
#   openssl req -x509 -newkey rsa:2048 -keyout /opt/moonlight-web/key.pem -out /opt/moonlight-web/cert.pem \
#     -days 3650 -nodes -subj "/CN=<SERVER_IP>" -addext "subjectAltName=IP:<SERVER_IP>"
# WebRTC UDP 段 40000-40010(可选通道);nat_1to1 直接用公网 IP 当 host 候选(国内禁 Google STUN)
ExecStart=/opt/moonlight-web/package/web-server \
  --ssl-certificate /opt/moonlight-web/cert.pem \
  --ssl-private-key /opt/moonlight-web/key.pem \
  --bind-address 0.0.0.0:18080 \
  --webrtc-port-range 40000:40010 \
  --webrtc-nat-1to1-host <SERVER_IP> \
  run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
